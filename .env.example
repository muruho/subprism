# =================================================================
# SubPrism Environment Configuration (.env.example)
# =================================================================

# 1. Admin Authentication
# Default username is "admin". If ADMIN_PASSWORD is left empty, 
# a 16-char random password with upper/lower/digits will be auto-generated at startup.
ADMIN_NAME=admin
ADMIN_PASSWORD=

# 2. Security Secret (JWT Session)
AUTH_SECRET=sub_mgr_secret_jwt_key_2026_super_secure

# 3. Master Salt for 16-char Subscription Token Generation
SUB_TOKEN=my_subscription_master_token_salt

# 4. MySQL Database Configuration
# Recommended: provide a full connection string.
MYSQL_URL=mysql://user:password@localhost:3306/subprism
# Alternatively configure the discrete fields below (used when MYSQL_URL is empty).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 5. Email Notification Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SubPrism <notifications@resend.dev>

# 6. Telegram Bot Notification Service
TELEGRAM_BOT_TOKEN=

# 7. Public Application URL (Used for generating subscription links)
APP_URL=http://localhost:3000

# 8. Edge Function Runtime
# 是否运行在边缘函数环境（true/false，默认 false）。
# 为 true 时跳过数据库建表初始化，直接进行增删改查。
IS_EDGE=false
